# ===== 单容器：后端(FastAPI) + 前端(Vite dev) + nginx(HTTPS 443) =====
FROM python:3.11-slim

# 系统依赖：ffmpeg/libsndfile 供 librosa；nodejs/npm 供前端 vite；nginx/openssl 供 HTTPS；cron 供证书自动续期
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    nodejs \
    npm \
    nginx \
    openssl \
    cron \
    && rm -rf /var/lib/apt/lists/*

# 安装 certbot（Let's Encrypt 证书自动申请/续期）
RUN pip install --no-cache-dir certbot

# 移除 nginx 默认站点（仅保留自定义 HTTPS 配置）
RUN rm -f /etc/nginx/sites-enabled/default

WORKDIR /app

# 安装 uv 并安装后端依赖（复用缓存层）
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev 2>/dev/null || uv sync --no-dev

# 安装前端依赖（vite dev server 运行时需要）
COPY frontend/package.json frontend/package-lock.json* frontend/
WORKDIR /app/frontend
RUN npm install

# 拷贝全部源码（.dockerignore 已排除 node_modules/.venv 等）
WORKDIR /app
COPY . .

# nginx HTTPS 配置 + 启动脚本
COPY docker/nginx-https.conf /etc/nginx/conf.d/default.conf
COPY docker/entrypoint.sh /app/docker/entrypoint.sh

# 仅对外开放 443（前端 5173 / 后端 8000 只绑定容器内部 127.0.0.1）
EXPOSE 443

CMD ["bash", "/app/docker/entrypoint.sh"]
