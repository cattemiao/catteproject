# ===== 数据库 =====
# 开发期使用 SQLite，生产期切换 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/catte

# ===== JWT 鉴权 =====
SECRET_KEY=change-me-to-a-random-secret
ALGORITHM=HS256
# session 超时时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ===== 管理员账号 =====
# admin 登录密码（不落库，仅存于此环境变量；留空则禁用 admin 登录）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ===== Apple Music API =====
APPLE_MUSIC_KEY_ID=YOUR_KEY_ID
APPLE_MUSIC_TEAM_ID=YOUR_TEAM_ID
APPLE_MUSIC_PRIVATE_KEY_PATH=./AuthKey_YOUR_KEY_ID.p8
APPLE_MUSIC_DEVELOPER_TOKEN=
# 前端 MusicKit 应用 JWT，可与开发令牌相同

# ===== 爬虫 =====
CRAWL_DELAY_MIN=2.0
CRAWL_DELAY_MAX=5.0

# ===== CORS =====
FRONTEND_ORIGIN=http://localhost:5173
